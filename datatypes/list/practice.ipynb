    "# Print the first, middle, and last elements of the list created in Assignment 1.\n",
    "\n",
    "list1= []\n",
    "for i in range (1,21):\n",
    "  list1.append(i)\n",
    "print(list1)\n",
    "\n",
    "print(list1[0])\n",
    "print(list1[-1])\n",
    "mid = len(list1)/2\n",
    "print(list1[int(mid)])\n",
    "\n",
    "# else \n",
    "print(list1[len(list1)//2])"
   ]
